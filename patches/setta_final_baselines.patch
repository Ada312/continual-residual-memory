+def _order_files_from_manifest(files, manifest_path):
+    """Return the exact test stream declared by a dataset manifest."""
+    manifest_path = Path(manifest_path)
+    with manifest_path.open(newline='', encoding='utf-8') as handle:
+        rows = list(csv.DictReader(handle))
+
+    required_columns = {'utt_id', 'test_order'}
+    columns = set(rows[0]) if rows else set()
+    missing_columns = required_columns - columns
+    if missing_columns:
+        raise ValueError(
+            f'{manifest_path} is missing columns: {sorted(missing_columns)}'
+        )
+
+    ordered_rows = []
+    seen_orders = set()
+    seen_files = set()
+    for row in rows:
+        try:
+            order = int(row['test_order'])
+        except (TypeError, ValueError) as error:
+            raise ValueError(
+                f"invalid test_order {row.get('test_order')!r} in {manifest_path}"
+            ) from error
+        filename = row['utt_id']
+        if not filename.lower().endswith('.wav'):
+            filename += '.wav'
+        if order in seen_orders:
+            raise ValueError(f'duplicate test_order {order} in {manifest_path}')
+        if filename in seen_files:
+            raise ValueError(f'duplicate utterance {filename} in {manifest_path}')
+        seen_orders.add(order)
+        seen_files.add(filename)
+        ordered_rows.append((order, filename))
+
+    available_files = set(files)
+    missing_files = seen_files - available_files
+    extra_files = available_files - seen_files
+    if missing_files or extra_files:
+        raise ValueError(
+            f'{manifest_path} does not exactly match the clean directory; '
+            f'missing={sorted(missing_files)[:5]}, extra={sorted(extra_files)[:5]}'
+        )
+
+    return [filename for _, filename in sorted(ordered_rows)]
+
+
